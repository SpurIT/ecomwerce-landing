---
// Compared (brand book ComparisonTable; 3-landing-page.md section 7; copy.md, comparison; DECISIONS.md 2026-11-11):
// Ecomwerce, PagePilot, Dropmagic and Forge AI on how you pay and how each publishes, never on speed. Every cell comes
// from src/data/competitors.mjs (prices re-checked on the listings on CHECKED); the table's markup is build-brand.mjs
// compareTable()'s, copied: change it there first; the audit compares them. On phones one card per question (css).
import { APPS, ROWS, SOURCE } from '../data/competitors.mjs';
import { PRICE } from '../data/landing.mjs';

const others = APPS.filter((a) => !a.us).map((a) => a.name);
const label = `Ecomwerce compared with ${others.slice(0, -1).join(', ')} and ${others.at(-1)}`;
const table = `<div class="ew-compare"><table role="table" aria-label="${label}"><thead role="rowgroup"><tr role="row"><td role="cell"></td>${APPS.map((a) => `<th role="columnheader" scope="col"${a.us ? ' class="ew-compare__us"' : ''}>${a.name}</th>`).join('')}</tr></thead><tbody role="rowgroup">${ROWS.map(([k, row]) => `<tr role="row"><th role="rowheader" scope="row">${row}</th>${APPS.map((a) => `<td role="cell"${a.us ? ' class="ew-compare__us"' : ''} data-label="${a.name}">${a.cells[k]}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
---
<section class="lp-section" id="compare" aria-labelledby="compare-title">
  <div class="lp-wrap">
    <div class="lp-head">
      <span class="ew-eyebrow">Compared</span>
      <h2 class="ew-display-l" id="compare-title">Pay per test, not per month</h2>
      <p class="ew-lead">PagePilot, Dropmagic and Forge AI sell monthly plans. With Ecomwerce you pay ${PRICE.perPage} for each product page, and nothing in a month without tests.</p>
    </div>
    <Fragment set:html={table} />
    <p class="ew-note ew-compare__src">{SOURCE}</p>
  </div>
</section>
