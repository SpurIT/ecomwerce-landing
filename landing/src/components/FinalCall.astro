---
// FinalCall (brand book): the hero's headline again on orange, Install and the official badge, the price sentence.
import badge from '../../../brand/shopify/badge-shopify-app-store-dark.svg?url';
import { installHref } from '../lib/site.mjs';

interface Props { headline: string; campaign: string }
const { headline, campaign } = Astro.props;
---
<section class="lp-section" aria-labelledby="final-title">
  <div class="lp-wrap">
    <div class="ew-stage ew-final">
      <h2 class="ew-display-l" id="final-title">{headline}</h2>
      <div class="ew-final__actions">
        <a class="ew-btn ew-btn--on-orange ew-btn--lg" data-install="final" href={installHref(campaign, 'final')}>Install free</a>
        <a class="ew-badge" data-install="final-badge" href={installHref(campaign, 'final-badge')}><img src={badge} width="211" height="56" alt="Find it on the Shopify App Store" loading="lazy"></a>
      </div>
      <p class="ew-small">Free to install. Your first 2 product pages are free, then $3 per product page. Monthly cap of $60.</p>
    </div>
  </div>
</section>
