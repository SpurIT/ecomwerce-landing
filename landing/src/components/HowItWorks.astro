---
// How it works (brand book Steps, pictured; 3-landing-page.md section 3; copy.md, how it works): three real steps, each
// with a drawn scene on the orange stage. The scenes' markup is the brand generators' (scenePick, sceneWrite, sceneLive
// in brand/tools/build-brand.mjs), copied: change it there first. Step 2's scene carries data-build and no
// ew-scene--build: src/scripts/landing.js adds it and plays the build once when the scene comes into view; without the
// script or with reduced motion the scene is finished from the start. The time line and its footnote are g4's.
import { isOpen } from '../lib/site.mjs';

const time = isOpen('g4');
// the hero's placeholder product (never a real brand's product), hidden from assistive technology inside a scene
const PHOTO = '<svg class="ew-photo" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><rect width="400" height="400" fill="#F3EEE8"/><ellipse cx="200" cy="322" rx="122" ry="13" fill="#E4DBD1"/><path d="M118 128h164l-48 98h-68z" fill="#E7DCD1"/><rect x="140" y="216" width="120" height="14" rx="7" fill="#D7CBBF"/><path d="M128 238h144v46a40 40 0 0 1-40 40h-64a40 40 0 0 1-40-40z" fill="#FFFFFF" stroke="#D7CBBF" stroke-width="3"/><path d="M272 252h14a22 22 0 0 1 0 44h-10" fill="none" stroke="#D7CBBF" stroke-width="9"/></svg>';
const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
const row = (w: number) => `<li><span class="ew-pick__box"></span><span class="ew-pick__thumb"></span><span class="ew-scene__line" style="width:${w}%"></span></li>`;
const pick = `<div class="ew-scene__panel" aria-hidden="true"><span class="ew-scene__label">Shopify catalog</span><ul class="ew-pick">${row(46)}<li class="ew-pick__on"><span class="ew-pick__box">${CHECK}</span><span class="ew-pick__thumb">${PHOTO}</span><span class="ew-pick__name">Ceramic pour-over set</span><span class="ew-pick__price">$34.00</span></li>${row(38)}${row(52)}</ul></div>`;
const write = `<div class="ew-scene__panel" aria-hidden="true"><span class="ew-write__top"><span class="ew-write__photo">${PHOTO}</span><span class="ew-write__head"><span class="ew-scene__label">Headline</span><span class="ew-write__h"></span><span class="ew-write__h" style="width:62%"></span><span class="ew-write__buy"></span></span></span><span class="ew-write__block"><span class="ew-scene__label">Benefits</span><span class="ew-scene__line"></span><span class="ew-scene__line" style="width:78%"></span></span><span class="ew-write__block"><span class="ew-scene__label">Why it stands out</span><span class="ew-write__four"><span></span><span></span><span></span><span></span></span></span><span class="ew-write__block"><span class="ew-scene__label">FAQ</span><span class="ew-write__q"><span class="ew-scene__line" style="width:70%"></span></span><span class="ew-write__q"><span class="ew-scene__line" style="width:56%"></span></span></span></div>`;
const live = `<span class="ew-live__phone" aria-hidden="true"><span class="ew-live__screen"><span class="ew-live__img">${PHOTO}</span><span class="ew-live__t"></span><span class="ew-live__p"></span><span class="ew-live__buy"></span><span class="ew-live__l"></span><span class="ew-live__l" style="width:72%"></span></span></span><span class="ew-live__side" aria-hidden="true"><span class="ew-live__go">Go live</span><span class="ew-scene__panel ew-live__lib"><span class="ew-scene__label">Theme library</span><span class="ew-live__theme"><span class="ew-live__swatch"></span><span><b>Your current theme</b><span>Switch back any time</span></span></span></span></span>`;
---
<section class="lp-section" id="how" aria-labelledby="how-title">
  <div class="lp-wrap">
    <div class="lp-head">
      <span class="ew-eyebrow">How it works</span>
      <h2 class="ew-display-l" id="how-title">From your catalog to a product page</h2>
    </div>
    <ol class="ew-steps ew-steps--pictured">
      <li class="ew-step">
        <div class="ew-step__pic"><div class="ew-scene ew-scene--pick" role="img" aria-label="Illustration: products from your Shopify catalog in a list, with one of them, a ceramic pour-over set, picked." set:html={pick} /></div>
        <div class="ew-step__text"><span class="ew-step__n">01</span><h3 class="ew-h">Pick a product</h3><p class="ew-p">Choose products from your Shopify catalog. Their photos and details are where the page starts.</p></div>
      </li>
      <li class="ew-step">
        <div class="ew-step__pic"><div class="ew-scene ew-scene--write" data-build role="img" aria-label="Illustration: a product page filling in with a headline, benefits, reasons it stands out and an FAQ." set:html={write} /></div>
        <div class="ew-step__text"><span class="ew-step__n">02</span><h3 class="ew-h">Ecomwerce writes the page</h3><p class="ew-p">A headline, benefits, reasons it stands out and an FAQ, in English, in a new theme on your store. {time ? <Fragment>About two minutes for one product.<sup>1</sup></Fragment> : 'The app shows how long it takes before you start, and you can close it while it works.'}</p></div>
      </li>
      <li class="ew-step">
        <div class="ew-step__pic"><div class="ew-scene ew-scene--live" role="img" aria-label="Illustration: the new product page on a phone, a Go live button, and your current theme kept in your theme library." set:html={live} /></div>
        <div class="ew-step__text"><span class="ew-step__n">03</span><h3 class="ew-h">Preview, then go live</h3><p class="ew-p">See the page on your store first. It goes live only when you press Go live, and your current theme stays in your theme library.</p></div>
      </li>
    </ol>
    {time && <p class="ew-note lp-footnote">1. One product, product page only: 4 of 5 builds on our test store finished within 1 min 57 s (October 2026).</p>}
  </div>
</section>
