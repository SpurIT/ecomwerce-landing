---
// Lucide check and x (ISC licence) at 1.75px stroke, 20px (brand README, Iconography); always beside words.
interface Props { name: 'check' | 'x' }
const PATHS = { check: '<path d="M20 6 9 17l-5-5"/>', x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>' };
---
<svg class="ew-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={PATHS[Astro.props.name]} /></svg>
