---
// The sections below the hero, in the order of 3-landing-page.md (phase 4): what you get (Anatomy, which takes in g3's
// sample), how it works (HowItWorks, g4), real data only (g2), pricing with what testing costs (CostChart), the
// comparison (Compare) and the faq (g2, g4). A closed gate's part is not in the html; its launch line is (copy.md,
// gates). The scope block left the page in phase 4: its facts live in the faq, and "Always yours" keeps two lines
// (the go-live fact is in step 3 and in "Will it change my live store?").
import Anatomy from './Anatomy.astro';
import Compare from './Compare.astro';
import CostChart from './CostChart.astro';
import HowItWorks from './HowItWorks.astro';
import Icon from './Icon.astro';
import { installHref, isOpen } from '../lib/site.mjs';

interface Props { campaign: string }
const { campaign } = Astro.props;
const time = isOpen('g4');
const honest = isOpen('g2');
---
<Anatomy />

<HowItWorks />

{honest && (
<section class="lp-section" id="honest" aria-labelledby="honest-title">
  <div class="lp-wrap">
    <div class="lp-head">
      <span class="ew-eyebrow">Real data only</span>
      <h2 class="ew-display-l" id="honest-title">No invented proof on your pages</h2>
      <p class="ew-lead">Ecomwerce never makes up reviews, ratings or stock levels. Social proof comes from your real data, or it stays off the page.</p>
    </div>
    <div class="ew-honest">
      <div class="ew-honest__col ew-never"><h3 class="ew-heading-3">Never added by Ecomwerce</h3><ul>
        <li><Icon name="x" />Invented reviews or star ratings</li>
        <li><Icon name="x" />Review counts or “people bought this” lines</li>
        <li><Icon name="x" />Stock bars or countdown timers</li>
        <li><Icon name="x" />“Verified” badges</li>
      </ul></div>
      <div class="ew-honest__col ew-always"><h3 class="ew-heading-3">Always yours</h3><ul>
        <li><Icon name="check" />Your photos and product details</li>
        <li><Icon name="check" />Your real reviews, when you add them</li>
      </ul></div>
    </div>
  </div>
</section>
)}

<section class="lp-section lp-pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="lp-wrap">
    <div class="lp-head">
      <span class="ew-eyebrow">Pricing</span>
      <h2 class="ew-display-l" id="pricing-title">The page is the cheapest part of your test</h2>
      <p class="ew-lead">Free to install. Your first 2 product pages are free, then $3 per product page.</p>
    </div>
    <div class="lp-cols lp-pricing__cols">
      <div class="lp-span-7"><CostChart /></div>
      <div class="lp-span-5 lp-pricing__plan">
        <div class="ew-price">
          <span class="ew-eyebrow">One plan</span>
          <h3 class="ew-heading-2">Pay as you go</h3>
          <div class="ew-price__big"><b>$3</b><span class="ew-num">per product page</span></div>
          <ul>
            <li><Icon name="check" />Free to install, no monthly fee</li>
            <li><Icon name="check" />Your first 2 product pages are free</li>
            <li><Icon name="check" />Monthly cap of $60</li>
            <li><Icon name="check" />Failed builds are never charged</li>
            <li><Icon name="check" />Billed on your Shopify invoice</li>
          </ul>
          <a class="ew-btn ew-btn--block ew-btn--lg" data-install="pricing" href={installHref(campaign, 'pricing')}>Install free</a>
        </div>
        <ul class="ew-bill">
          <li>A page is charged when its build is ready.</li>
          <li>While your free pages last, a build takes up to 2 products. With the plan, up to 10.</li>
          <li>You choose the plan in Shopify when your 2 free pages are used.</li>
          <li>The $60 cap counts 30 days from the day you choose the plan.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<Compare />

<section class="lp-section lp-faq" id="faq" aria-labelledby="faq-title">
  <div class="lp-wrap lp-cols">
    <div class="lp-span-4"><div class="lp-head"><span class="ew-eyebrow">FAQ</span><h2 class="ew-display-l" id="faq-title">Questions before you install</h2></div></div>
    <div class="lp-span-8">
      <div class="ew-faq">
        <details open><summary>Will it change my live store?</summary><p>Not until you press Go live. Ecomwerce builds the page in a new theme on your store, based on Horizon, Shopify’s free theme, and you preview it first. When you go live, that theme becomes your live theme and your current one moves to your theme library, so you can switch back.</p></details>
        <details><summary>Do I need a Shopify store?</summary><p>Yes. Ecomwerce picks products from your Shopify catalog, so it needs your store with your product in it. No store yet? Press Install, then create your Shopify account and store when Shopify asks. No product yet? Add it by hand or with your supplier app, then pick it in Ecomwerce.</p></details>
        <details><summary>Does it work on Shopify’s $1 plan?</summary><p>Yes. Your first 2 product pages are free, so you can build them while you pay Shopify $1 a month. After that, each product page is $3, billed on your Shopify invoice next to your plan.</p></details>
        <details><summary>Can I edit the page?</summary><p>Yes. Open it in the Shopify theme editor and change it like any page of your theme, before or after you go live.</p></details>
        <details><summary>What if I don’t like the page?</summary><p>Don’t go live, and your live store stays as it is. Change the page in the theme editor, or build it again: a new build is one more product page, $3 once your 2 free pages are used.</p></details>
        <details><summary>What does it cost?</summary><p>Free to install. Your first 2 product pages are free, then $3 per product page. Monthly cap of $60. Failed builds are never charged, and you pay on your Shopify invoice.</p></details>
        <details><summary>How long does a page take?</summary><p>Minutes. The app shows its estimate before you start, and you can close it while the page is built.{time && ' On our test store, 4 of 5 one-product builds finished within 1 min 57 s (October 2026).'}</p></details>
        <details><summary>Which languages does it write in?</summary><p>English for now.</p></details>
        <details><summary>Is my store ready to sell after this?</summary><p>Not by itself. Ecomwerce writes the product page. Payments, shipping, policies and your domain stay in your Shopify settings.</p></details>
        <details><summary>What happens if I uninstall?</summary><p>The pages are built with Ecomwerce blocks, so their content disappears from your store when you uninstall. The app says so before you go live.</p></details>
        {honest && <details><summary>Does it add reviews or ratings?</summary><p>Only real ones. Ecomwerce never invents reviews, ratings or counters. If you add your real reviews, the page shows them.</p></details>}
      </div>
    </div>
  </div>
</section>
