---
// SiteFooter (brand book): SpurIT and the contact (ad platform rules), the legal links, "Privacy choices" (shown by the
// script: without it no tag loads, so there is nothing to choose), the official badge (white in dark mode).
import lockup from '../../../brand/logo/ecomwerce-lockup.svg?url';
import lockupWhite from '../../../brand/logo/ecomwerce-lockup-white.svg?url';
import badge from '../../../brand/shopify/badge-shopify-app-store-dark.svg?url';
import badgeWhite from '../../../brand/shopify/badge-shopify-app-store-light.svg?url';
import { INPUTS } from '../data/landing.mjs';
import { installHref } from '../lib/site.mjs';

interface Props { campaign: string; choices?: boolean }
const { campaign, choices = true } = Astro.props;
---
<footer class="ew-footer">
  <div class="lp-wrap ew-footer__grid">
    <div class="ew-footer__brand">
      <img class="ew-light-only" src={lockup} width="150" height="28" alt="Ecomwerce" loading="lazy">
      <img class="ew-dark-only" src={lockupWhite} width="150" height="28" alt="Ecomwerce" loading="lazy">
      <p class="ew-small">Made by SpurIT</p>
      <p class="ew-small">Support: {INPUTS.supportEmail ? <a href={`mailto:${INPUTS.supportEmail}`}>{INPUTS.supportEmail}</a> : '[support email]'}</p>
    </div>
    <ul class="ew-footer__links" aria-label="Legal">
      <li><a href="/privacy/">Privacy policy</a></li>
      <li><a href="/terms/">Terms</a></li>
      <li><a href="/cookies/">Cookies</a></li>
      <li><a href="/legal-notice/">Legal notice</a></li>
      {choices && <li data-consent-link hidden><button type="button" data-consent-open="settings">Privacy choices</button></li>}
    </ul>
    <div class="ew-footer__badge">
      <a class="ew-badge" data-install="footer-badge" href={installHref(campaign, 'footer-badge')}>
        <img class="ew-light-only" src={badge} width="166" height="44" alt="Find it on the Shopify App Store" loading="lazy">
        <img class="ew-dark-only" src={badgeWhite} width="166" height="44" alt="Find it on the Shopify App Store" loading="lazy">
      </a>
    </div>
    <div class="ew-footer__legal">
      <p class="ew-note">Shopify is a trademark of Shopify Inc.</p>
      <p class="ew-note">© 2026 SpurIT</p>
    </div>
  </div>
</footer>
