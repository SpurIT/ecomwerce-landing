---
// Every page of the site: the three variants and the three legal pages, each built twice, at its path and under
// /_optin/ (the copy the edge serves to the EEA, the UK, Switzerland and unknown countries: edge/geo.mjs).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import FinalCall from '../components/FinalCall.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { OPTIN_PREFIX, VARIANTS, INPUTS } from '../data/landing.mjs';
import { LEGAL } from '../data/legal.mjs';
import { gated } from '../lib/site.mjs';

export function getStaticPaths() {
  const pages = [
    ...Object.entries(VARIANTS).map(([id, v]) => ({ kind: 'landing', id, path: v.path })),
    ...Object.entries(LEGAL).map(([id, d]) => ({ kind: 'legal', id, path: d.path })),
  ];
  return pages.flatMap((p) => [false, true].map((optin) => {
    const full = (optin ? OPTIN_PREFIX : '') + p.path;
    return { params: { path: full.replace(/^\/|\/$/g, '') || undefined }, props: { ...p, optin } };
  }));
}

const { kind, id, path, optin } = Astro.props;
const v = kind === 'landing' ? VARIANTS[id] : null;
const d = kind === 'legal' ? LEGAL[id] : null;
const headline = v ? gated(v.headline) : '';
const updated = d && new Date(d.updated + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
{v && (
<Base title={gated(v.title)} path={path} index={id === 'default'} optin={optin} campaign={id}>
  <SiteHeader campaign={id} />
  <main id="top">
    <Hero variant={v} headline={headline} campaign={id} />
    <Sections campaign={id} />
    <FinalCall headline={headline} campaign={id} />
  </main>
  <SiteFooter campaign={id} />
</Base>
)}
{d && (
<Base title={`Ecomwerce: ${d.title.toLowerCase()}`} path={path} index={INPUTS.legalTextsConfirmed} optin={optin} campaign="legal">
  <SiteHeader campaign="legal" onPage={false} />
  <main id="top" class="lp-wrap">
    <article class="lp-doc">
      <h1 class="ew-display-l">{d.title}</h1>
      <p class="lp-updated">Last updated {updated}</p>
      {d.sections.map((s) => (
        <Fragment>
          {s.h && <h2>{s.h}</h2>}
          {s.p && s.p.map((p) => <p set:html={p} />)}
          {s.ul && <ul>{s.ul.map((li) => <li set:html={li} />)}</ul>}
          {s.table && (
            <table>
              <thead><tr>{s.table.head.map((h) => <th>{h}</th>)}</tr></thead>
              <tbody>{s.table.rows.map((r) => <tr>{r.map((c, k) => <td data-label={s.table.head[k]}>{c}</td>)}</tr>)}</tbody>
            </table>
          )}
          {s.after && s.after.map((p) => <p set:html={p} />)}
        </Fragment>
      ))}
    </article>
  </main>
  <SiteFooter campaign="legal" onPage={false} />
</Base>
)}
